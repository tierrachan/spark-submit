import sys
import matplotlib
matplotlib.use("Agg")  # sin entorno gráfico (SSH)
import matplotlib.pyplot as plt
from pyspark.sql import SparkSession
from pyspark.sql import functions as F
 
DATA_PATH = sys.argv[1] if len(sys.argv) > 1 else "data/dataset.csv"
COL_CATEGORIA = "categoria"   # ajustar
COL_VALOR = "valor"           # ajustar (numérica)
COL_FECHA = "fecha"           # ajustar (opcional)
 
spark = (SparkSession.builder.appName("BatchAnalysis")
         .config("spark.sql.shuffle.partitions", "8").getOrCreate())
spark.sparkContext.setLogLevel("WARN")
 
# 1. Carga desde la fuente original
df = spark.read.csv(DATA_PATH, header=True, inferSchema=True)
print("Filas:", df.count(), "| Columnas:", len(df.columns))
df.printSchema()
 
# 2. Limpieza
df = df.dropDuplicates()
df.select([F.sum(F.col(c).isNull().cast("int")).alias(c) for c in df.columns]).show(truncate=False)
df = df.dropna(subset=[COL_CATEGORIA, COL_VALOR])
df = df.withColumn(COL_VALOR, F.col(COL_VALOR).cast("double"))
 
# 3. Transformación
if COL_FECHA in df.columns:
    df = df.withColumn("anio", F.year(F.to_date(F.col(COL_FECHA))))
 
# 4. Análisis exploratorio
df.describe(COL_VALOR).show()
por_cat = (df.groupBy(COL_CATEGORIA)
             .agg(F.count("*").alias("n"), F.round(F.avg(COL_VALOR), 2).alias("promedio"))
             .orderBy(F.desc("n")))
por_cat.show(10, truncate=False)
 
# 5. Visualización (solo se convierte a pandas el resultado agregado)
top = por_cat.limit(10).toPandas()
plt.figure(figsize=(9, 5))
plt.barh(top[COL_CATEGORIA].astype(str), top["n"])
plt.gca().invert_yaxis()
plt.title("Top 10 categorías por número de registros")
plt.tight_layout()
plt.savefig("output/top_categorias.png", dpi=150)
 
spark.stop()
